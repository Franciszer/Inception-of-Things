# Part 2 — K3s with three web applications (HOST-based Ingress routing)

LOGIN     = 'frthierr'
VM_NAME   = "#{LOGIN}S"
VM_IP     = '192.168.56.110'
VM_BOX    = 'ubuntu/jammy64'
VM_CPUS   = '2'
VM_RAM_MB = '2048'

Vagrant.configure('2') do |config|
  config.vm.box = VM_BOX
  config.vm.boot_timeout = 600

  config.vm.define VM_NAME do |vm|
    vm.vm.hostname = VM_NAME
    vm.vm.network 'private_network', ip: VM_IP

    vm.vm.provider 'virtualbox' do |vb|
      vb.name   = "#{VM_NAME}-p2"
      vb.cpus   = VM_CPUS
      vb.memory = VM_RAM_MB
    end

    # Synced folder disabled — running inside nested VM without host mount
    config.vm.synced_folder '.', '/vagrant', disabled: true

    # Copy K8s manifests into the guest (file provisioner uses SCP)
    vm.vm.provision 'file', source: 'confs/app.yaml', destination: '/tmp/app.yaml'

    # Install K3s + deploy applications
    vm.vm.provision 'shell', path: 'scripts/bootstrap_vm.sh', args: [VM_IP]
  end
end
