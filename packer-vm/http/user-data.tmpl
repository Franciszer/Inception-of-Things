#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network
  network:
    version: 2
    ethernets:
      enp0s3:
        dhcp4: true

  # Storage
  storage:
    layout:
      name: lvm

  # Identity
  identity:
    hostname: iot-eval-machine
    username: ychibani
    password: '$6$55jR6Fx19j5/Y8yn$Hb4EQD5qacRAs0tMdl1vMz7h5HaS9.OzjPCkmacQnN2owZZozDNrG.QnMZONlk4PiBjeVnmVmNTCuJmroy79R/'

  # SSH
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - __SSH_PUBLIC_KEY__

  # Packages
  packages:
    - openssh-server
    - cloud-init
    - net-tools
    - curl
    - wget
    - git
    - vim
    - build-essential

  # Late commands
  late-commands:
    - echo 'ychibani ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ychibani
    - chmod 440 /target/etc/sudoers.d/ychibani
    - curtin in-target --target=/target -- sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- sh -c "echo 'PasswordAuthentication yes' > /etc/ssh/sshd_config.d/50-cloud-init.conf"
    - curtin in-target --target=/target -- systemctl restart sshd

  # User data
  user-data:
    disable_root: false
    package_update: true
    package_upgrade: true
    ssh_pwauth: true
